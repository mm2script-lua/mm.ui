local ReplicatedStorage = game:GetService('ReplicatedStorage')
local LocalPlayer = game:GetService('Players').LocalPlayer

-- Load Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create Window
local Window = Rayfield:CreateWindow({
   Name = "Murder Mystery 2 Weapon Spawner",
   LoadingTitle = "Loading MM2 Spawner",
   LoadingSubtitle = "by KaiScripts",
   ConfigurationSaving = {
      Enabled = false,
   },
   Discord = {
      Enabled = false,
      Invite = "noinvitelink", 
      RememberJoins = true 
   },
   KeySystem = false
})

-- Create Main Tab
local MainTab = Window:CreateTab("Spawner", 4483362458) 

-- Variable to store the typed text
local targetItemName = ""

-- UI Elements
MainTab:CreateParagraph({
    Title = "Instructions", 
    Content = "Spawn any items • Case-sensitive\nYT: KaizScripts"
})

local ItemInput = MainTab:CreateInput({
   Name = "Item Name",
   PlaceholderText = "e.g. HeartWand",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
       targetItemName = Text
   end,
})

local SpawnButton = MainTab:CreateButton({
   Name = "Spawn Item",
   Callback = function()
       -- Clean the input string
       local itemName = targetItemName:match('^%s*(.-)%s*$')
       
       if itemName == "" then
           Rayfield:Notify({
               Title = "Input Error",
               Content = "Please enter an item name first.",
               Duration = 3,
               Image = 4483362458,
           })
           return
       end

       -- Safely find the remote
       local shop = ReplicatedStorage:WaitForChild('Remotes', 5) and ReplicatedStorage.Remotes:FindFirstChild('Shop')
       local boxController = shop and shop:FindFirstChild('BoxController')

       if boxController and boxController:IsA('RemoteEvent') then
           boxController:FireServer('KnifeBox4', itemName)
       else
           warn("BoxController remote not found!")
       end

       -- Safely handle the local inventory addition
       local success, profileData = pcall(function()
           return require(ReplicatedStorage.Modules.ProfileData)
       end)

       if success and profileData and profileData.Weapons and profileData.Weapons.Owned then
           local owned = profileData.Weapons.Owned
           owned[itemName] = (owned[itemName] or 0) + 1 
       else
           warn("Could not find local inventory data.")
       end

       -- Reset character
       if LocalPlayer.Character then
           LocalPlayer.Character:BreakJoints()
       end

       -- Notify the user
       Rayfield:Notify({
           Title = "Item Spawned",
           Content = "Spawned: " .. itemName,
           Duration = 3,
           Image = 4483362458,
       })
   end,
})

